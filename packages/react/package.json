{
  "name": "@sebellds/react",
  "version": "0.3.0",
  "description": "React component library for the design system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomassebell/design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/thomassebell/design-system#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "multi-brand"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src stories && stylelint \"src/components/**/*.module.css\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@sebellds/tokens": "^0.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@vitest/ui": "^2.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-modules": "^6.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^10.3.6",
    "stylelint": "^16.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.8",
    "vitest": "^2.1.9"
  }
}
